# Safaricom M-Pesa (developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_KEY=your_daraja_consumer_key
MPESA_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_sandbox_passkey
# Airtel Money (developers.airtel.africa)
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
# Receiving account (see README). Sandbox: leave these two out.
# For a Buy Goods Till: MPESA_TXN_TYPE=CustomerBuyGoodsOnline and MPESA_PARTYB=your_till_number
# For a Paybill: leave MPESA_TXN_TYPE unset and set MPESA_SHORTCODE=your_paybill
MPESA_TXN_TYPE=
MPESA_PARTYB=
# Optional: restrict who may call the payment server, e.g. https://username.github.io
ALLOWED_ORIGIN=
